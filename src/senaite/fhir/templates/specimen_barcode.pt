<tal:css>
  <style type="text/css">
    @page { size: 54mm 18mm; margin: 0; }
    html, body { height: 18mm; margin: 0; width: 54mm; }
    body { text-align: center; }
    .barcode { height: 16mm; margin: 1mm auto; }
    .barcode img { display: block; height: 16mm; margin: 0 auto;
                   max-width: 52mm; }
  </style>
</tal:css>

<tal:render>
  <div class="barcode">
    <img alt="" tal:attributes="src python: view.image_uri" />
  </div>
</tal:render>
