<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:monkey="http://namespaces.plone.org/monkey">

  <include package="plone.behavior" file="meta.zcml"/>

  <plone:behavior
      name="senaite.fhir.contact.IExtendedContactBehavior"
      title="ExtendedContact"
      description="Extends Contact with additional fields"
      provides=".contact.IExtendedContactBehavior"
      factory=".contact.ExtendedContact"
      for="senaite.core.interfaces.IContact" />

  <monkey:patch
      class="senaite.core.content.contact.Contact"
      original="getFHIRExternalID"
      ignoreOriginal="True"
      replacement=".contact.getFHIRExternalID"/>

  <monkey:patch
      class="senaite.core.content.contact.Contact"
      original="setFHIRExternalID"
      ignoreOriginal="True"
      replacement=".contact.setFHIRExternalID"/>

</configure>
